APP_NAME="MiddlewareFiscal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# IMPORTANTE: stderr faz o log sair no 'docker logs'
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- CONFIGURAÇÃO DO BANCO DE DADOS (DOCKER) ---
DB_CONNECTION=mysql
# Nome do serviço definido no docker-compose.yml
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=middleware_db
DB_USERNAME=middleware
# Sua senha definida no docker-compose
DB_PASSWORD=secret

# --- DRIVERS (Use Redis para tudo em produção) ---
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- CONFIGURAÇÃO DO REDIS (DOCKER) ---
# Nome do serviço definido no docker-compose.yml
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-MAIL (Configure se for usar) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS (Se usar S3, preencha aqui) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- CONFIGURAÇÃO DO OCTANE/SWOOLE ---
OCTANE_SERVER=swoole
OCTANE_HTTPS=false

# --- FOCUS NFE ---
FOCUS_URL=https://homologacao.focusnfe.com.br
FOCUS_TOKEN=seu_token_aqui

# --- ODOO ---
ODOO_URL=http://url_do_odoo_aqui
ODOO_TOKEN=seu_token_aqui
# Shared secret used to authenticate incoming webhooks from Odoo (X-Webhook-Token header)
ODOO_WEBHOOK_SECRET=gere_uma_string_aleatoria_forte_aqui

# --- CONFIGURAÇÕES FISCAIS (SEFAZ) ---
# Ex: 13 (AM), 35 (SP), 33 (RJ)
FISCAL_UF=13
FISCAL_CNPJ_EMITENTE=00000000000000
FISCAL_TIMEZONE=America/Manaus
FISCAL_SERIE_CONTINGENCIA=600

# URLs da SEFAZ para geração do QR Code (Verifique a documentação da sua UF)
FISCAL_QRCODE_URL_PRODUCAO=https://sistemas.sefaz.am.gov.br/nfceweb/consultarNFCe.jsp
FISCAL_QRCODE_URL_HOMOLOGACAO=https://homnfce.sefaz.am.gov.br/nfceweb/consultarNFCe.jsp
FISCAL_URL_CONSULTA=http://www.nfce.sefaz.am.gov.br/consumidor/